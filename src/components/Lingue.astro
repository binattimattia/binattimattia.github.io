---
---
<section id="lingue" class="py-20 border-t border-border/50">
  <div class="mb-10">
    <h2 class="text-3xl font-display font-bold flex items-center gap-4">
      <span class="text-accent text-xl">05.</span> Lingue
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Italiano -->
    <div class="p-6 rounded-lg bg-surface border border-border">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-bold flex items-center gap-2">
          <span>🇮🇹</span> Italiano
        </h3>
        <span class="text-accent text-sm font-display">Madrelingua</span>
      </div>
      <div class="w-full h-1.5 bg-border rounded-full overflow-hidden">
        <div class="h-full bg-accent w-full"></div>
      </div>
    </div>

    <!-- Inglese -->
    <div class="p-6 rounded-lg bg-surface border border-border group relative">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-bold flex items-center gap-2">
          <span>🇬🇧</span> Inglese
        </h3>
        <span class="text-accent-2 text-sm font-display">B1</span>
      </div>
      <div class="w-full h-1.5 bg-border rounded-full overflow-hidden mb-3">
        <div class="h-full bg-accent-2 w-[60%]"></div>
      </div>
      <p class="text-xs text-muted">Esame Cambridge sostenuto 23 maggio 2026 — risultato in attesa</p>
    </div>

    <!-- Spagnolo -->
    <div class="p-6 rounded-lg bg-surface border border-border">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-bold flex items-center gap-2">
          <span>🇪🇸</span> Spagnolo
        </h3>
        <span class="text-muted text-sm font-display">A2</span>
      </div>
      <div class="w-full h-1.5 bg-border rounded-full overflow-hidden mb-3">
        <div class="h-full bg-muted w-[30%]"></div>
      </div>
      <p class="text-xs text-muted">Conoscenza scolastica</p>
    </div>
  </div>
</section>
